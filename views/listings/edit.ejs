<% layout("/layouts/boilerplate") %>
<div class="row">
  <div class="col-8 offset-2">
    <h3>Edit your Listing</h3>

    <form
      action="/listings/<%=listing._id%>?_method=PUT"
      method="POST"
      class="needs-validation"
      novalidate
    >
      <div class="mb-3">
        <input
          name="listing[title]"
          value="<%= listing.title %>"
          type="text"
          class="form-control"
          required
        />
         <div class="invalid-feedback">Please Add Title.</div>
        <div class="valid-feedback">Looks good!</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description</label>

        <textarea name="listing[description]" class="form-control" required>
          <%= listing.description %></textarea>
           <div class="invalid-feedback">Please Add Description.</div>
        <div class="valid-feedback">Looks good!</div>
      </div>

      <div class="mb-3">
        <label for="image" class="form-label">Image Link/url</label>

        <input
          name="listing[image][url]"
          value="<%= listing.image.url %>"
          type="text"
          class="form-control"
          required
        />
         <div class="invalid-feedback">Please Add Image url</div>
        <div class="valid-feedback">Looks good!</div>
      </div>

      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label">Price</label>
          <input
            name="listing[price]"
            value="<%= listing.price %>"
            type="number"
            class="form-control"
            required
          />
           <div class="invalid-feedback">Please Add price.</div>
        <div class="valid-feedback">Looks good!</div>
        </div>
        <div class="mb-3 col-md-8">
          <label for="price" class="form-label">Country</label>

          <input
            type="text"
            name="listing[country]"
            value="<%= listing.country %>"
            class="form-control"
            required
          />
           <div class="invalid-feedback">Please Add country name</div>
        <div class="valid-feedback">Looks good!</div>
        </div>
      </div>

      <div class="mb-3">
        <label for="title" class="form-label">Location</label>

        <input
          type="text"
          name="listing[location]"
          value="<%= listing.location %>"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Please Add Location.</div>
        <div class="valid-feedback">Looks good!</div>
      </div>

      <div>
        <button type="submit" class="btn btn-dark edit-btn">Edit</button>
      </div>
    </form>
  </div>
</div>
