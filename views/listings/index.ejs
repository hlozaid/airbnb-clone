<style>
    /* Filters + toggle hamesha ek hi line me */
    #filters-wrapper {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
    }

    /* Filters: bachi hui jagah me slider */
    #filters {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        flex: 1 1 auto;
        min-width: 0;                 /* zaroori: iske bina slider kaam nahi karta */
        overflow-x: auto;
        overflow-y: hidden;
        padding-right: 2rem;          /* last filter fade ke bahar aa sake */

        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior-x: contain;

        scrollbar-width: none;
        -ms-overflow-style: none;

        cursor: grab;
        user-select: none;
        -webkit-user-select: none;

        /* right side me halka fade, toggle ke paas */
        -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 2rem), transparent);
        mask-image: linear-gradient(to right, #000 calc(100% - 2rem), transparent);
    }

    #filters::-webkit-scrollbar {
        display: none;
    }

    #filters.dragging {
        cursor: grabbing;
        scroll-behavior: auto;
    }

    .filter {
        flex: 0 0 auto;
        text-align: center;
        margin-right: 2rem;
        margin-top: 2rem;
        cursor: pointer;
        opacity: 0.7;
        white-space: nowrap;
        transition: color 0.2s ease, opacity 0.2s ease;
    }

    .filter:hover {
        color: #fe424d;
        opacity: 1;
    }

    .filter p {
        font-size: 0.8rem;
        margin-bottom: 0;
    }

    .tax-info {
        display: none;
    }

    /* Toggle: hamesha right side me, shrink nahi hoga */
    .tax-toggle {
        flex: 0 0 auto;
        border: 1px solid black;
        border-radius: 1rem;
        height: 3.2rem;
        padding: 1rem;
        margin-left: 1rem;
        margin-top: 2rem;
        display: flex;
        align-items: center;
        white-space: nowrap;
        background: #fff;
    }

    /* Tablet / mobile: sab thoda chhota */
    @media (max-width: 768px) {
        .filter {
            margin-right: 1.5rem;
            margin-top: 1rem;
        }

        .tax-toggle {
            margin-top: 1rem;
            height: 3rem;
            padding: 0 0.8rem;
        }

        .tax-toggle .form-check-label {
            font-size: 0.8rem;
        }
    }
</style>

