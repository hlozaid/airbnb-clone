<% layout("/layouts/boilerplate") %>

<style>
    /* Filters + toggle hamesha ek hi line me */
    #filters-wrapper {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
    }

    /* Filters: bachi hui jagah me slider */
    #filters {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        flex: 1 1 auto;
        min-width: 0;                 /* zaroori: iske bina slider kaam nahi karta */
        overflow-x: auto;
        overflow-y: hidden;
        padding-right: 2rem;          /* last filter fade ke bahar aa sake */

        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior-x: contain;

        scrollbar-width: none;
        -ms-overflow-style: none;

        cursor: grab;
        user-select: none;
        -webkit-user-select: none;

        /* right side me halka fade, toggle ke paas */
        -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 2rem), transparent);
        mask-image: linear-gradient(to right, #000 calc(100% - 2rem), transparent);
    }

    #filters::-webkit-scrollbar {
        display: none;
    }

    #filters.dragging {
        cursor: grabbing;
        scroll-behavior: auto;
    }

    .filter {
        flex: 0 0 auto;
        text-align: center;
        margin-right: 2rem;
        margin-top: 2rem;
        cursor: pointer;
        opacity: 0.7;
        white-space: nowrap;
        transition: color 0.2s ease, opacity 0.2s ease;
    }

    a.filter,
    a.filter:hover {
        color: inherit;
        text-decoration: none;
    }

    .filter:hover {
        color: #fe424d;
        opacity: 1;
    }

    /* Selected filter */
    .filter.active {
        color: #fe424d;
        opacity: 1;
        border-bottom: 2px solid #fe424d;
        padding-bottom: 0.4rem;
    }

    .filter p {
        font-size: 0.8rem;
        margin-bottom: 0;
    }

    .tax-info {
        display: none;
    }

    /* Toggle: hamesha right side me, shrink nahi hoga */
    .tax-toggle {
        flex: 0 0 auto;
        border: 1px solid black;
        border-radius: 1rem;
        height: 3.2rem;
        padding: 1rem;
        margin-left: 1rem;
        margin-top: 2rem;
        display: flex;
        align-items: center;
        white-space: nowrap;
        background: #fff;
    }

    /* Tablet / mobile: sab thoda chhota */
    @media (max-width: 768px) {
        .filter {
            margin-right: 1.5rem;
            margin-top: 1rem;
        }

        .tax-toggle {
            margin-top: 1rem;
            height: 3rem;
            padding: 0 0.8rem;
        }

        .tax-toggle .form-check-label {
            font-size: 0.8rem;
        }
    }
</style>

<%
  // Filter/search links ek doosre ko preserve karte hain
  const listUrl = (cat) => {
    const params = new URLSearchParams();
    if (q) params.set("q", q);
    if (cat) params.set("category", cat);
    const qs = params.toString();
    return "/listings" + (qs ? "?" + qs : "");
  };
  const activeLabel = (categories.find((c) => c.value === activeCategory) || {}).label;
%>

<div id="filters-wrapper">
  <div id="filters">
    <% for (let c of categories) { %>
      <a
        class="filter <%= activeCategory === c.value ? 'active' : '' %>"
        href="<%= listUrl(activeCategory === c.value ? '' : c.value) %>"
        draggable="false"
        title="<%= activeCategory === c.value ? 'Click to remove filter' : 'Show ' + c.label %>"
      >
        <div><i class="<%= c.icon %>"></i></div>
        <p><%= c.label %></p>
      </a>
    <% } %>
  </div>

  <div class="tax-toggle">
    <div class="form-check form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
    </div>
  </div>
</div>

<% if (q || activeCategory) { %>
  <div class="d-flex align-items-center gap-3 mt-4">
    <p class="mb-0">
      <b><%= allListings.length %></b>
      <%= allListings.length === 1 ? "listing" : "listings" %>
      <% if (q) { %> for "<b><%= q %></b>"<% } %>
      <% if (activeLabel) { %> in <b><%= activeLabel %></b><% } %>
    </p>
    <a href="/listings" class="btn btn-sm btn-outline-dark">Clear</a>
  </div>
<% } %>

<% if (allListings.length === 0) { %>
  <div class="text-center my-5">
    <h5>No listings found</h5>
    <p class="text-muted">Try a different search or remove the filter.</p>
  </div>
<% } %>

<!-- card -->
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
  <% for (let listing of allListings) { %>
    <a href="/listings/<%= listing._id %>" class="listing-link">
      <div class="card col listing-card">
        <img
          src="<%= listing.image.url %>"
          class="card-img-top"
          alt="listing Image"
          style="height: 20rem;"
        />
        <div class="card-img-overlay">discount</div>
        <div class="card-body">
          <p class="card-text">
            <b><%= listing.title %></b> <br />
            &#8377;<%= (listing.price || 0).toLocaleString("en-IN") %>/night
            <i class="tax-info">&nbsp;&nbsp;+18% GST (&#8377;<%= Math.round((listing.price || 0) * 1.18).toLocaleString("en-IN") %> total)</i>
          </p>
        </div>
      </div>
    </a>
  <% } %>
</div>

<script>
  // Tax toggle
  const taxSwitch = document.getElementById("switchCheckDefault");

  taxSwitch.addEventListener("click", () => {
    const taxInfo = document.getElementsByClassName("tax-info");
    for (let info of taxInfo) {
      info.style.display = (info.style.display !== "inline") ? "inline" : "none";
    }
  });

  // Filters slider: mouse drag to scroll (touch already works natively)
  const slider = document.getElementById("filters");
  let isDown = false;
  let startX = 0;
  let startScroll = 0;
  let moved = false;

  slider.addEventListener("mousedown", (e) => {
    isDown = true;
    moved = false;
    slider.classList.add("dragging");
    startX = e.pageX;
    startScroll = slider.scrollLeft;
  });

  window.addEventListener("mouseup", () => {
    if (!isDown) return;
    isDown = false;
    slider.classList.remove("dragging");
  });

  window.addEventListener("mousemove", (e) => {
    if (!isDown) return;
    e.preventDefault();
    if (Math.abs(e.pageX - startX) > 5) moved = true;
    slider.scrollLeft = startScroll - (e.pageX - startX);
  });

  // Drag karke chhodne par galti se filter link open na ho
  slider.addEventListener(
    "click",
    (e) => {
      if (moved) {
        e.preventDefault();
        e.stopPropagation();
        moved = false;
      }
    },
    true
  );

  // Selected filter ko slider ke beech me le aao
  const activeFilter = slider.querySelector(".filter.active");
  if (activeFilter) {
    slider.scrollLeft +=
      activeFilter.getBoundingClientRect().left -
      slider.getBoundingClientRect().left -
      (slider.clientWidth - activeFilter.offsetWidth) / 2;
  }
</script>
