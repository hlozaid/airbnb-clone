<% layout("/layouts/boilerplate") %>
  <body>

    <h3>Create a new Listing </h3>

    <form action="/listings" method="POST">
      <input name="listing[title]" placeholder="enter title" type="text"/>
      <br /><br>
      <textarea name="listing[description]" placeholder="enter description" ></textarea> <br /><br>
      <input name="listing[image]" placeholder="image url/link" type="text"/> <br /><br>
      <input name="listing[price]" placeholder="enter price" type="number"/>
      <br /><br>
      <input type="text" name="listing[location]" placeholder="Enter location">
      <br><br>
      <input type="text" name="listing[country]" placeholder="Enter country"><br><br>
      <button>Add</button>
    </form>
  </body>
  